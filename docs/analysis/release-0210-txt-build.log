{
  "plugin": "TopFlow 屏幕",
  "version": "0.2.10",
  "defaultViewOnly": false,
  "nativeAutostart": {
    "failure": "existing-factory-rollback",
    "systemStartupFilesModified": false,
    "uninstall": "remove-owned-hook-and-bounded-state",
    "disabledCancelsPending": true,
    "deviceBootVerified": false,
    "integrity": "boot-integrity.sha256",
    "defaultEnabled": false,
    "attemptsPerBoot": 1,
    "hook": "/data/plugins/ufi_tools_boot.sh",
    "readinessSecondsMaximum": 120,
    "retry": false
  },
  "nativeFactoryPower": {
    "preflight": "effective-uci-read",
    "quickenAckPerEvent": 1,
    "subscribesShutdownParticipant": false,
    "quickenAck": "quickening-event-only-dark-confirmed",
    "sleepProviderLookupMilliseconds": 500,
    "sleepProviderRemoval": "explicit-mc-off-only",
    "additionalResidentProcesses": 0,
    "field": "mode_main_state",
    "sleepProviderResume": "mc-on-and-provider-ready",
    "rebootEvent": "zwrt_mode_lcd_reboot",
    "lateCompletion": "exact-sequence-once-bounded4",
    "completionLookup": "readonly-short-lived-child",
    "writesFactoryMode": false,
    "sleepProviderOffPolling": false,
    "quickenAckMethod": "poweroff_quicken_compelte",
    "off": "mode_power_off*",
    "normalAck": "oem-off-reboot-dark-confirmed",
    "unknownAfterOff": "remain-dark",
    "normalAckMethod": "poweroff_compelte",
    "darkCorrection": "only-if-observed-bright",
    "settingIsPowerState": false,
    "on": [
      "mode_power_on",
      "mode_power_on_charger"
    ],
    "section": "mode",
    "completionRpcMilliseconds": 1500,
    "quickenAckPerCycle": 1,
    "completionUnknown": "remain-dark-no-replay",
    "offEventLatch": "until-mc-on",
    "sourcePriority": "event-before-raw",
    "inputDuringOff": "discard",
    "source": "/etc/config/zwrt_zte_mc_tmp",
    "concurrentLookupChildrenMaximum": 1,
    "quickenAckResetFlag": 0,
    "resetAck": false,
    "hardwareTested": false,
    "sleepProviderRecoveryMilliseconds": 3000,
    "sleepProviderSubscribeMilliseconds": 1000,
    "completionLookupMilliseconds": 500,
    "normalAckPerCycle": 1,
    "completionResult": "confirmed-unknown-stale",
    "darkReadbackMilliseconds": 1000,
    "eventSource": "zwrt_device_power_state_event"
  },
  "nativePowerKey": {
    "timeoutMilliseconds": 10000,
    "thresholdMilliseconds": 1200,
    "alreadyAwake": "preserve-unlocked-state",
    "outcome": "transport-progress-without-retry",
    "cancel": "restore-page-and-scroll",
    "completeResponse": "framed-response-before-eof",
    "confirmation": "second-confirmation-and-capability-recheck",
    "authorization": "control_guard",
    "clearOn": [
      "sleep",
      "resync"
    ],
    "longPress": "power-menu-overlay",
    "actions": [
      "device.poweroff",
      "device.reboot"
    ],
    "locked": "menu-visible-actions-disabled",
    "submissionsPerConfirmation": 1,
    "capabilityEndpoint": "http://127.0.0.1:9460/capabilities",
    "hardwareTested": false,
    "asleep": "existing-wake-before-menu",
    "controlEndpoint": "http://127.0.0.1:9460/control",
    "invalidateOldPending": true,
    "automaticRetry": false
  },
  "nativeLockWallpaper": {
    "bufferBytes": 307200,
    "hardwareTested": false,
    "unknownUpload": "retain-old-image-explicit-abort-no-retry",
    "transaction": "sha256-nonce32-current-boot-id-offset",
    "noBackgroundPolling": true,
    "width": 320,
    "commit": "same-directory-atomic-rename",
    "pixelFormat": "RGB565_LE",
    "staging": ".lock-wallpaper.upload",
    "uninstallRemovesCustomWallpaper": true,
    "chunkBytesMaximum": 24576,
    "factoryFilesUntouched": true,
    "stalePixels": "never-commit-after-boot-change",
    "receipt": ".lock-wallpaper.pending",
    "transport": "run-shell-locked-chunks",
    "uninstallPending": "remove-owned-pending-under-lifecycle-lock",
    "recovery": "nonce-and-current-boot-guarded-explicit-abort",
    "format": "TFWP5651",
    "chunk": ".lock-wallpaper.chunk",
    "checks": [
      "root-owner",
      "regular-file",
      "no-symlink",
      "single-hardlink",
      "size",
      "header",
      "sha256"
    ],
    "fallback": "default",
    "height": 480,
    "fileBytes": 307216,
    "refresh": "lock-entry",
    "path": "/data/plugins/topflow-screen/lock-wallpaper.rgb565"
  },
  "nativeControlAuthorization": {
    "initial": "blocked-until-adopt-and-unlock",
    "sleep": "revoked",
    "manualEnableGate": false,
    "noPin": "hold-to-unlock-local",
    "writes": "per-action-confirmation",
    "pin": "requires-pin-policy-and-login"
