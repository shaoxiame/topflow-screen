    "deviceSwitchVerified": false,
    "externalMustBeEnabled": true,
    "readback": "raw-st_slot",
    "unknownReadback": "unconfirmed",
    "targets": [
      "5G",
      "4G1",
      "4G2"
    ],
    "requiresKnownSource": false,
    "rawSource": "0-removable-1-builtin",
    "presenceRequired": false
  },
  "nativeSms": {
    "automaticRetry": false,
    "authorization": "existing-UFI-session-with-AD",
    "sessionRestoreMaxPerMinute": 3,
    "confirmedResult": "UFI-result-success",
    "sessionRestoreCookiePersist": false,
    "action": "SEND_SMS",
